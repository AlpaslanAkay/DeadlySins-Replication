. * ============================================================
. * 8. Program to write one descriptive row
. * ============================================================
. 
. capture program drop write_desc_row

. program define write_desc_row
  1.     version 17
  2.     syntax varname, LABEL(string)
  3. 
.     local row "`label'"
  4.     local serow " "
  5. 
.     forvalues j = 1/6 {
  6.         local cond "${G`j'}"
  7. 
.         quietly summarize `varlist' if `cond'
  8. 
.         if r(N) > 0 {
  9.             local mean : display %9.3f r(mean)
 10.             local sd   : display %9.3f r(sd)
 11. 
.             local mean = strtrim("`mean'")
 12.             local sd   = strtrim("`sd'")
 13. 
.             local row   "`row' & `mean'"
 14.             local serow "`serow' & (`sd')"
 15.         }
 16.         else {
 17.             local row   "`row' & "
 18.             local serow "`serow' & "
 19.         }
 20.     }
 21. 
.     file write fh "`row' \\" _n
 22.     file write fh "`serow' \\" _n
 23. end

. 
