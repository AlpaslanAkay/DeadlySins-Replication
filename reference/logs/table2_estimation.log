. * ============================================================
. * 6. Program: estimate one specification
. * ============================================================
. 
. capture program drop run_attendance_spec

. program define run_attendance_spec
  1.     version 17
  2. 
.     syntax, EST(name) RGVARS(string) MINCELL(integer) ///
>         [GINI MEDIAN RANK CONSUMP DENOMONLY FIXSAMPLE(name) SAVESAMPLE(name)]
  3. 
.     foreach v in rg_tmp nref_tmp sum_val_tmp med_val_tmp ref_tmp ///
>         gini_tmp rank_tmp rankx_tmp sum_rankx_tmp relrank_tmp pos_tmp ///
>         own_tmp val_tmp own_never own_any ref_never ref_any sample_tmp {
  4.         capture drop `v'
  5.     }
  6. 
.     if "`consump'" != "" {
  7.         gen double own_tmp = lcons_0
  8.         gen double val_tmp = cons1
  9.         gen byte sample_tmp = sample_cons_base
 10.     }
 11.     else {
 12.         gen double own_tmp = labs_0
 13.         gen double val_tmp = inc1
 14.         gen byte sample_tmp = sample_income_base
 15.     }
 16. 
.     if "`denomonly'" != "" {
 17.         replace sample_tmp = 0 if christian_cp_sample != 1
 18.     }
 19. 
.     if "`fixsample'" != "" {
 20.         replace sample_tmp = 0 if `fixsample' != 1
 21.     }
 22. 
.     egen long rg_tmp = group(`rgvars') if !missing(val_tmp)
 23. 
.     bysort rg_tmp: egen long nref_tmp = count(val_tmp)
 24.     bysort rg_tmp: egen double sum_val_tmp = total(val_tmp)
 25. 
.     gen double ref_tmp = .
 26. 
.     local cellrule "nref_tmp >= `mincell'"
 27. 
.     if "`rank'" != "" {
 28. 
.         sort rg_tmp val_tmp
 29.         by rg_tmp: egen double pos_tmp = rank(val_tmp)
 30. 
.         gen double relrank_tmp = .
 31.         replace relrank_tmp = (pos_tmp - 1) / (nref_tmp - 1) ///
>             if `cellrule' & nref_tmp > 1 & !missing(pos_tmp)
 32. 
.         replace ref_tmp = relrank_tmp
 33.     }
 34.     else if "`median'" != "" {
 35. 
.         bysort rg_tmp: egen double med_val_tmp = median(val_tmp)
 36. 
.         replace ref_tmp = log(med_val_tmp) ///
>             if `cellrule' & med_val_tmp > 0 & !missing(med_val_tmp)
 37.     }
 38.     else {
 39. 
.         replace ref_tmp = log((sum_val_tmp - val_tmp) / (nref_tmp - 1)) ///
>             if `cellrule' & nref_tmp > 1 ///
>             & !missing(val_tmp) & (sum_val_tmp - val_tmp) > 0
 40.     }
 41. 
.     if "`gini'" != "" {
 42. 
.         sort rg_tmp val_tmp
 43.         by rg_tmp: gen double rank_tmp = sum(!missing(val_tmp)) if !missing(val_tmp)
 44.         gen double rankx_tmp = rank_tmp * val_tmp if !missing(val_tmp)
 45. 
.         bysort rg_tmp: egen double sum_rankx_tmp = total(rankx_tmp)
 46. 
.         gen double gini_tmp = ///
>             (2 * sum_rankx_tmp) / (nref_tmp * sum_val_tmp) ///
>             - (nref_tmp + 1) / nref_tmp ///
>             if `cellrule' & nref_tmp > 1 & sum_val_tmp > 0
 47. 
.         replace sample_tmp = 0 if missing(gini_tmp)
 48.     }
 49. 
.     replace sample_tmp = 0 if missing(own_tmp)
 50.     replace sample_tmp = 0 if missing(ref_tmp)
 51.     replace sample_tmp = 0 if missing(any_attend)
 52.     replace sample_tmp = 0 if missing(rg_tmp)
 53. 
.     gen double own_never = 0 if sample_tmp == 1
 54.     gen double own_any   = 0 if sample_tmp == 1
 55.     gen double ref_never = 0 if sample_tmp == 1
 56.     gen double ref_any   = 0 if sample_tmp == 1
 57. 
.     replace own_never = own_tmp if sample_tmp == 1 & any_attend == 0
 58.     replace own_any   = own_tmp if sample_tmp == 1 & any_attend == 1
 59. 
.     replace ref_never = ref_tmp if sample_tmp == 1 & any_attend == 0
 60.     replace ref_any   = ref_tmp if sample_tmp == 1 & any_attend == 1
 61. 
.     sort $ID year
 62.     xtset $ID year
 63. 
.     if "`gini'" != "" {
 64.         xtreg $Y ///
>             c.own_never c.own_any ///
>             c.ref_never c.ref_any ///
>             i.any_attend ///
>             c.gini_tmp ///
>             $X ///
>             if sample_tmp == 1, ///
>             fe vce(cluster rg_tmp) nonest
 65.     }
 66.     else {
 67.         xtreg $Y ///
>             c.own_never c.own_any ///
>             c.ref_never c.ref_any ///
>             i.any_attend ///
>             $X ///
>             if sample_tmp == 1, ///
>             fe vce(cluster rg_tmp) nonest
 68.     }
 69. 
.     estimates store `est'
 70. 
.     if "`savesample'" != "" {
 71.         capture drop `savesample'
 72.         gen byte `savesample' = e(sample)
 73.     }
 74. 
.     di as text " "
 75.     di as text "Specification `est'"
 76.     di as text "N = " e(N) " ; Individuals = " e(N_g) " ; Within R2 = " %6.3f e(r2_w)
 77. 
.     foreach v in rg_tmp nref_tmp sum_val_tmp med_val_tmp ref_tmp ///
>         gini_tmp rank_tmp rankx_tmp sum_rankx_tmp relrank_tmp pos_tmp ///
>         own_tmp val_tmp own_never own_any ref_never ref_any sample_tmp {
 78.         capture drop `v'
 79.     }
 80. end

. 
