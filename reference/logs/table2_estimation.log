. * ============================================================
. * 9. Helper programs
. * ============================================================
. 
. capture program drop make_coef_from_est

. program define make_coef_from_est, rclass
  1.     version 17
  2.     syntax, EST(name) VAR(name)
  3. 
.     estimates restore `est'
  4. 
.     tempname b se t p
  5. 
.     capture scalar `b' = _b[`var']
  6.     if _rc {
  7.         return local bcell ""
  8.         return local secell ""
  9.         exit
 10.     }
 11. 
.     scalar `se' = _se[`var']
 12.     scalar `t'  = `b' / `se'
 13.     scalar `p'  = 2 * ttail(e(df_r), abs(`t'))
 14. 
.     if missing(`p') {
 15.         scalar `p' = 2 * normal(-abs(`t'))
 16.     }
 17. 
.     local stars ""
 18.     if (`p' < 0.01) {
 19.         local stars "***"
 20.     }
 21.     else if (`p' < 0.05) {
 22.         local stars "**"
 23.     }
 24.     else if (`p' < 0.10) {
 25.         local stars "*"
 26.     }
 27. 
.     local bstr : display %9.3f `b'
 28.     local sestr : display %9.3f `se'
 29. 
.     local bstr = strtrim("`bstr'")
 30.     local sestr = strtrim("`sestr'")
 31. 
.     return local bcell "`bstr'`stars'"
 32.     return local secell "(`sestr')"
 33. end

. 
. 
. capture program drop make_p_from_est

. program define make_p_from_est, rclass
  1.     version 17
  2.     syntax, EST(name) TEST(string)
  3. 
.     estimates restore `est'
  4. 
.     capture quietly test `test'
  5.     if _rc {
  6.         return local pcell ""
  7.         exit
  8.     }
  9. 
.     local pstr : display %9.3f r(p)
 10.     local pstr = strtrim("`pstr'")
 11. 
.     return local pcell "`pstr'"
 12. end

. 
. 
. capture program drop make_stat_from_est

. program define make_stat_from_est, rclass
  1.     version 17
  2.     syntax, EST(name) STAT(string)
  3. 
.     estimates restore `est'
  4. 
.     if "`stat'" == "N" {
  5.         local v : display %12.0fc e(N)
  6.     }
  7.     else if "`stat'" == "N_g" {
  8.         local v : display %12.0fc e(N_g)
  9.     }
 10.     else if "`stat'" == "r2_w" {
 11.         local v : display %9.3f e(r2_w)
 12.     }
 13. 
.     local v = strtrim("`v'")
 14.     return local value "`v'"
 15. end

. 
. 
. * ============================================================
. * 10. Collect table entries
. * ============================================================
. 
. foreach m in R1 R2 R3 R4 R5 R6 R7 R8 R9 {
  2. 
.     quietly make_coef_from_est, est(`m') var(own_never)
  3.     local c_own_never_`m' "`r(bcell)'"
  4.     local s_own_never_`m' "`r(secell)'"
  5. 
.     quietly make_coef_from_est, est(`m') var(own_any)
  6.     local c_own_any_`m' "`r(bcell)'"
  7.     local s_own_any_`m' "`r(secell)'"
  8. 
.     quietly make_coef_from_est, est(`m') var(ref_never)
  9.     local c_ref_never_`m' "`r(bcell)'"
 10.     local s_ref_never_`m' "`r(secell)'"
 11. 
.     quietly make_coef_from_est, est(`m') var(ref_any)
 12.     local c_ref_any_`m' "`r(bcell)'"
 13.     local s_ref_any_`m' "`r(secell)'"
 14. 
.     quietly make_p_from_est, est(`m') test("own_never = own_any")
 15.     local p_own_`m' "`r(pcell)'"
 16. 
.     quietly make_p_from_est, est(`m') test("ref_never = ref_any")
 17.     local p_ref_`m' "`r(pcell)'"
 18. 
.     quietly make_stat_from_est, est(`m') stat(N)
 19.     local n_`m' "`r(value)'"
 20. 
.     quietly make_stat_from_est, est(`m') stat(N_g)
 21.     local id_`m' "`r(value)'"
 22. 
.     quietly make_stat_from_est, est(`m') stat(r2_w)
 23.     local r2_`m' "`r(value)'"
 24. }

. 
. 
. * ============================================================
. * 11. Write LaTeX table
. * ============================================================
. 
. local texfile "$OUTDIR/table_robustness_attendance_income_gradients.tex"

. 
. capture file close fh

